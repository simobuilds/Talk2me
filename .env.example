# Frontend: leave empty for same-origin in production.
VUE_APP_SOCKET_URL=http://localhost:3000

# Server: local Redis can use redis://localhost:6379.
# On Render, this is injected automatically from render.yaml.
REDIS_URL=redis://localhost:6379

# Server: optional when frontend is hosted on a different origin.
CORS_ORIGIN=http://localhost:8080

# Server: local defaults are shown here for clarity.
PORT=3000
NODE_ENV=development